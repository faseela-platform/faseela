# Copy to `.env.local` and fill in. `.env.local` is gitignored; this file is not.
#
# One env file at the repo root, not one per package. `packages/db`, its test
# harness, the verification scripts and `apps/web` all read the same connection
# strings, and a second copy guarantees the two drift — with the wrong copy being
# the one production uses. `apps/web/next.config.ts` loads this file explicitly
# because Next.js only auto-loads `.env*` from the app directory.

# ---------------------------------------------------------------------------
# Neon Postgres
# ---------------------------------------------------------------------------

# Pooled host — note the `-pooler` in the hostname. Application queries only.
# Neon's pooler is PgBouncer in transaction mode: no prepared statements, no
# LISTEN/NOTIFY, no session-level state.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Unpooled host — the same database without `-pooler`. Required for DDL:
# migrations need advisory locks and a stable connection across statements, which
# transaction-mode pooling cannot hold. Pointing migrations at the pooled host
# produces failures that read as intermittent network faults.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------------------------------
# Payload CMS — Editors
# ---------------------------------------------------------------------------

# Signs Payload's admin session cookies. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating it signs out every Editor.
PAYLOAD_SECRET=

# ---------------------------------------------------------------------------
# Better Auth — Members
# ---------------------------------------------------------------------------

# Signs Member session cookies and magic-link tokens. Deliberately NOT the same
# value as PAYLOAD_SECRET: the two systems authenticate different populations,
# and sharing one secret means rotating Editor sessions logs out every Member.
BETTER_AUTH_SECRET=

# The public origin. Magic-link URLs are built from this, so in production it
# must match where the app actually answers. A stale value produces links that
# fail verification — which looks like a token bug, not a config error.
BETTER_AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Email — magic-link delivery (Resend)
# ---------------------------------------------------------------------------

# When BOTH of these are set, apps/web/lib/email.ts sends real mail via Resend
# and sign-in opens (/dukhul shows the form). Leave them unset to keep the
# console transport in development and the loud guard in production — sign-in
# then stays closed and /dukhul shows "not open yet". This is the whole on/off
# switch; opening sign-in is config, not code.
#
# The provider needs SPF + DKIM on a domain you control and verified in Resend
# BEFORE sending — a borrowed/unverified domain lands links in spam, which for a
# product whose only way in is an emailed link is a locked door.
#
# RESEND_API_KEY  — from resend.com (starts with re_).
# EMAIL_FROM      — the sender, e.g.  فسيلة <no-reply@your-domain.tld>
# EMAIL_REPLY_TO  — optional; where replies go.
# NOTE: these three are also listed in turbo.json globalPassThroughEnv — Turbo
# strips any env var not declared there, so a missing entry silently reverts the
# production transport to the guard.
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
