{
  "name": "faseela-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:boundaries": "depcruise packages apps",
    "test": "turbo run test",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:boundaries && pnpm test && pnpm build",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "dependency-cruiser": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
