{
  "name": "faseela-platform",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:boundaries": "depcruise packages apps",
    "test": "turbo run test",
    "verify:db": "node scripts/verify-db.mjs",
    "verify:isolation": "node scripts/verify-isolation.mjs",
    "verify:routes": "node scripts/verify-routes.mjs",
    "verify:auth": "node scripts/verify-auth-flow.mjs",
    "verify:seed": "node scripts/verify-seed.mjs",
    "verify:journey": "node scripts/verify-journey.mjs",
    "seed": "node scripts/seed.mjs",
    "seed:dry": "node scripts/seed.mjs --dry-run",
    "clean:probes": "node scripts/clean-probe-rows.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm lint:boundaries && pnpm test && pnpm build",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "dependency-cruiser": "^17.0.0",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "pg": "^8.22.0",
    "playwright": "^1.62.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
